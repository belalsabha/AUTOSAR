<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 ../AUTOSAR_ARXML_Schema/AUTOSAR_00046.xsd">
	<!--  Eng. Belal Hani Sabha -> SWC Runnable Lab1 -->
	<AR-PACKAGES>
		<AR-PACKAGE>
			<SHORT-NAME>SWC_Runnable_Lab1</SHORT-NAME>
			<ELEMENTS>
				<!-- 1. Define SENDER-RECEIVER INTERFACES-->
				<SENDER-RECEIVER-INTERFACE>
					<SHORT-NAME>Throttle_CMD_Interface</SHORT-NAME>
					<DATA-ELEMENTS>
						<VARIABLE-DATA-PROTOTYPE>
							<SHORT-NAME>Throttle_CMD</SHORT-NAME>
							<TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_PlatformTypes/ImplementationDataTypes/uint32</TYPE-TREF>
						</VARIABLE-DATA-PROTOTYPE>
					</DATA-ELEMENTS>
				</SENDER-RECEIVER-INTERFACE>
				<!-- 2. Define SWCs -->
				<APPLICATION-SW-COMPONENT-TYPE>
					<SHORT-NAME>Throttle_Control_CMD_SWC</SHORT-NAME>
					<PORTS>
						<P-PORT-PROTOTYPE>
							<SHORT-NAME>Throttle_CMD_PPort</SHORT-NAME>
							<PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/SWC_Runnable_Lab1/Throttle_CMD_Interface</PROVIDED-INTERFACE-TREF>
						</P-PORT-PROTOTYPE>
					</PORTS>
					<INTERNAL-BEHAVIORS>
						<SWC-INTERNAL-BEHAVIOR>
							<SHORT-NAME>TC_CMD_Behaviour</SHORT-NAME>
							<RUNNABLES>
								<RUNNABLE-ENTITY>
									<SHORT-NAME>SET_CMD_Runnable</SHORT-NAME>
									<MINIMUM-START-INTERVAL>0.0</MINIMUM-START-INTERVAL>
									<CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
									<DATA-WRITE-ACCESSS>
										<VARIABLE-ACCESS>
											<SHORT-NAME>CMD_Data</SHORT-NAME>
											<ACCESSED-VARIABLE>
												<AUTOSAR-VARIABLE-IREF>
													<PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/SWC_Runnable_Lab1/Throttle_Control_CMD_SWC/Throttle_CMD_PPort</PORT-PROTOTYPE-REF>
													<TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/SWC_Runnable_Lab1/Throttle_CMD_Interface/Throttle_CMD</TARGET-DATA-PROTOTYPE-REF>
												</AUTOSAR-VARIABLE-IREF>
											</ACCESSED-VARIABLE>
										</VARIABLE-ACCESS>
									</DATA-WRITE-ACCESSS>
									<SYMBOL>SET_CMD</SYMBOL>
								</RUNNABLE-ENTITY>
							</RUNNABLES>
						</SWC-INTERNAL-BEHAVIOR>
					</INTERNAL-BEHAVIORS>
				</APPLICATION-SW-COMPONENT-TYPE>
			</ELEMENTS>
		</AR-PACKAGE>
	</AR-PACKAGES>
</AUTOSAR>