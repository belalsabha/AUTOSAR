<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00046.xsd">
	<AR-PACKAGES>

		<!-- 0. DataTypes -->
		<AR-PACKAGE>
			<SHORT-NAME>DataTypes</SHORT-NAME>
			<ELEMENTS>
				<DATA-CONSTR>
					<SHORT-NAME>Uint8_T_Constr</SHORT-NAME>
					<DATA-CONSTR-RULES>
						<DATA-CONSTR-RULE>
							<PHYS-CONSTRS>
								<LOWER-LIMIT>0</LOWER-LIMIT>
								<UPPER-LIMIT>255</UPPER-LIMIT>
							</PHYS-CONSTRS>
							<INTERNAL-CONSTRS>
								<LOWER-LIMIT>0</LOWER-LIMIT>
								<UPPER-LIMIT>255</UPPER-LIMIT>
							</INTERNAL-CONSTRS>
						</DATA-CONSTR-RULE>
					</DATA-CONSTR-RULES>
				</DATA-CONSTR>
				<SW-BASE-TYPE>
					<SHORT-NAME>uint8</SHORT-NAME>
					<CATEGORY>FIXED_LENGTH</CATEGORY>
					<BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
					<BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
					<NATIVE-DECLARATION>unsigned char</NATIVE-DECLARATION>
				</SW-BASE-TYPE>
				<IMPLEMENTATION-DATA-TYPE>
					<SHORT-NAME>Uint8_T</SHORT-NAME>
					<CATEGORY>VALUE</CATEGORY>
					<SW-DATA-DEF-PROPS>
						<SW-DATA-DEF-PROPS-VARIANTS>
							<SW-DATA-DEF-PROPS-CONDITIONAL>
								<BASE-TYPE-REF DEST="SW-BASE-TYPE">/DataTypes/uint8</BASE-TYPE-REF>
								<DATA-CONSTR-REF DEST="DATA-CONSTR">/DataTypes/Uint8_T_Constr</DATA-CONSTR-REF>
							</SW-DATA-DEF-PROPS-CONDITIONAL>
						</SW-DATA-DEF-PROPS-VARIANTS>
					</SW-DATA-DEF-PROPS>
				</IMPLEMENTATION-DATA-TYPE>
			</ELEMENTS>
		</AR-PACKAGE>

		<!-- 1. Interfaces -->
		<AR-PACKAGE>
			<SHORT-NAME>Interfaces</SHORT-NAME>
			<ELEMENTS>
				<!-- 1.1 Client-Server -->
				<CLIENT-SERVER-INTERFACE>
					<SHORT-NAME>CS_LedControl_I</SHORT-NAME>
					<OPERATIONS>
						<CLIENT-SERVER-OPERATION>
							<SHORT-NAME>Switch_LedState</SHORT-NAME>
							<ARGUMENTS>
								<ARGUMENT-DATA-PROTOTYPE>
									<SHORT-NAME>LedState</SHORT-NAME>
									<TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/DataTypes/Uint8_T</TYPE-TREF>
									<DIRECTION>IN</DIRECTION>
								</ARGUMENT-DATA-PROTOTYPE>
							</ARGUMENTS>
							<POSSIBLE-ERROR-REFS>
								<POSSIBLE-ERROR-REF DEST="APPLICATION-ERROR">/Interfaces/CS_LedControl_I/E_LED_FAILED</POSSIBLE-ERROR-REF>
							</POSSIBLE-ERROR-REFS>
						</CLIENT-SERVER-OPERATION>
					</OPERATIONS>
					<POSSIBLE-ERRORS>
						<!-- 0 is reserved for RTE_E_OK; application errors start at 1 -->
						<APPLICATION-ERROR>
							<SHORT-NAME>E_LED_FAILED</SHORT-NAME>
							<ERROR-CODE>1</ERROR-CODE>
						</APPLICATION-ERROR>
					</POSSIBLE-ERRORS>
				</CLIENT-SERVER-INTERFACE>

				<!-- 1.2 Sender-Receiver -->
				<SENDER-RECEIVER-INTERFACE>
					<SHORT-NAME>SR_DoorState_I</SHORT-NAME>
					<DATA-ELEMENTS>
						<VARIABLE-DATA-PROTOTYPE>
							<SHORT-NAME>DoorState</SHORT-NAME>
							<TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/DataTypes/Uint8_T</TYPE-TREF>
							<INIT-VALUE>
								<NUMERICAL-VALUE-SPECIFICATION>
									<VALUE>0</VALUE>
								</NUMERICAL-VALUE-SPECIFICATION>
							</INIT-VALUE>
						</VARIABLE-DATA-PROTOTYPE>
					</DATA-ELEMENTS>
				</SENDER-RECEIVER-INTERFACE>
			</ELEMENTS>
		</AR-PACKAGE>

		<!-- 2. SWCs -->
		<AR-PACKAGE>
			<SHORT-NAME>SWCs</SHORT-NAME>
			<ELEMENTS>

				<!-- 2.1 Application SWC -->
				<APPLICATION-SW-COMPONENT-TYPE>
					<SHORT-NAME>DoorLockIndication_SWC</SHORT-NAME>
					<PORTS>
						<R-PORT-PROTOTYPE>
							<SHORT-NAME>R_DoorState</SHORT-NAME>
							<REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/SR_DoorState_I</REQUIRED-INTERFACE-TREF>
						</R-PORT-PROTOTYPE>
						<R-PORT-PROTOTYPE>
							<SHORT-NAME>R_LedControl</SHORT-NAME>
							<REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/Interfaces/CS_LedControl_I</REQUIRED-INTERFACE-TREF>
						</R-PORT-PROTOTYPE>
					</PORTS>
					<INTERNAL-BEHAVIORS>
						<SWC-INTERNAL-BEHAVIOR>
							<SHORT-NAME>DoorLockIndication_IB</SHORT-NAME>
							<EVENTS>
								<TIMING-EVENT>
									<SHORT-NAME>TE_DoorLockIndication_12ms</SHORT-NAME>
									<START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SWCs/DoorLockIndication_SWC/DoorLockIndication_IB/DoorLockIndication</START-ON-EVENT-REF>
									<PERIOD>0.012</PERIOD>
								</TIMING-EVENT>
							</EVENTS>
							<RUNNABLES>
								<RUNNABLE-ENTITY>
									<SHORT-NAME>DoorLockIndication</SHORT-NAME>
									<DATA-READ-ACCESSS>
										<VARIABLE-ACCESS>
											<SHORT-NAME>DRA_SwitchLedState</SHORT-NAME>
											<ACCESSED-VARIABLE>
												<AUTOSAR-VARIABLE-IREF>
													<PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/SWCs/DoorLockIndication_SWC/R_DoorState</PORT-PROTOTYPE-REF>
													<TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/SR_DoorState_I/DoorState</TARGET-DATA-PROTOTYPE-REF>
												</AUTOSAR-VARIABLE-IREF>
											</ACCESSED-VARIABLE>
										</VARIABLE-ACCESS>
									</DATA-READ-ACCESSS>
									<SERVER-CALL-POINTS>
										<SYNCHRONOUS-SERVER-CALL-POINT>
											<SHORT-NAME>SCP_SwitchLedState</SHORT-NAME>
											<OPERATION-IREF>
												<CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/SWCs/DoorLockIndication_SWC/R_LedControl</CONTEXT-R-PORT-REF>
												<TARGET-REQUIRED-OPERATION-REF
													DEST="CLIENT-SERVER-OPERATION">/Interfaces/CS_LedControl_I/Switch_LedState</TARGET-REQUIRED-OPERATION-REF>
											</OPERATION-IREF>
										</SYNCHRONOUS-SERVER-CALL-POINT>
									</SERVER-CALL-POINTS>
									<SYMBOL>DoorLockIndication_Run</SYMBOL>
								</RUNNABLE-ENTITY>
							</RUNNABLES>
						</SWC-INTERNAL-BEHAVIOR>
					</INTERNAL-BEHAVIORS>
				</APPLICATION-SW-COMPONENT-TYPE>

				<!-- 2.2 ECU Abstraction SWC -->
				<ECU-ABSTRACTION-SW-COMPONENT-TYPE>
					<SHORT-NAME>DoorSensorAbstraction_SWC</SHORT-NAME>
					<PORTS>
						<P-PORT-PROTOTYPE>
							<SHORT-NAME>P_DoorState</SHORT-NAME>
							<PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/SR_DoorState_I</PROVIDED-INTERFACE-TREF>
						</P-PORT-PROTOTYPE>
						<P-PORT-PROTOTYPE>
							<SHORT-NAME>P_LedControl</SHORT-NAME>
							<PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/Interfaces/CS_LedControl_I</PROVIDED-INTERFACE-TREF>
						</P-PORT-PROTOTYPE>
					</PORTS>
					<INTERNAL-BEHAVIORS>
						<SWC-INTERNAL-BEHAVIOR>
							<SHORT-NAME>DoorSensorAbstraction_IB</SHORT-NAME>
							<EVENTS>
								<TIMING-EVENT>
									<SHORT-NAME>TE_ReadDoorSensor_10ms</SHORT-NAME>
									<START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SWCs/DoorSensorAbstraction_SWC/DoorSensorAbstraction_IB/ReadDoorSensor</START-ON-EVENT-REF>
									<PERIOD>0.01</PERIOD>
								</TIMING-EVENT>
								<OPERATION-INVOKED-EVENT>
									<SHORT-NAME>OIE_SwitchLedState</SHORT-NAME>
									<START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SWCs/DoorSensorAbstraction_SWC/DoorSensorAbstraction_IB/SwitchLedState</START-ON-EVENT-REF>
									<OPERATION-IREF>
										<CONTEXT-P-PORT-REF DEST="P-PORT-PROTOTYPE">/SWCs/DoorSensorAbstraction_SWC/P_LedControl</CONTEXT-P-PORT-REF>
										<TARGET-PROVIDED-OPERATION-REF
											DEST="CLIENT-SERVER-OPERATION">/Interfaces/CS_LedControl_I/Switch_LedState</TARGET-PROVIDED-OPERATION-REF>
									</OPERATION-IREF>
								</OPERATION-INVOKED-EVENT>
							</EVENTS>
							<RUNNABLES>
								<RUNNABLE-ENTITY>
									<SHORT-NAME>ReadDoorSensor</SHORT-NAME>
									<MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
									<CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
									<DATA-WRITE-ACCESSS>
										<VARIABLE-ACCESS>
											<SHORT-NAME>VA_DoorState_Write</SHORT-NAME>
											<ACCESSED-VARIABLE>
												<AUTOSAR-VARIABLE-IREF>
													<PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/SWCs/DoorSensorAbstraction_SWC/P_DoorState</PORT-PROTOTYPE-REF>
													<TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/SR_DoorState_I/DoorState</TARGET-DATA-PROTOTYPE-REF>
												</AUTOSAR-VARIABLE-IREF>
											</ACCESSED-VARIABLE>
										</VARIABLE-ACCESS>
									</DATA-WRITE-ACCESSS>
									<SYMBOL>ReadDoorSensor_Run</SYMBOL>
								</RUNNABLE-ENTITY>
								<RUNNABLE-ENTITY>
									<SHORT-NAME>SwitchLedState</SHORT-NAME>
									<MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
									<CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
									<SYMBOL>SwitchLedState_Run</SYMBOL>
								</RUNNABLE-ENTITY>
							</RUNNABLES>
						</SWC-INTERNAL-BEHAVIOR>
					</INTERNAL-BEHAVIORS>
				</ECU-ABSTRACTION-SW-COMPONENT-TYPE>
			</ELEMENTS>
		</AR-PACKAGE>

		<!-- 3. Compositions -->
		<AR-PACKAGE>
			<SHORT-NAME>Compositions</SHORT-NAME>
			<ELEMENTS>
				<COMPOSITION-SW-COMPONENT-TYPE>
					<SHORT-NAME>DoorLockSystem_Comp</SHORT-NAME>
					<COMPONENTS>
						<SW-COMPONENT-PROTOTYPE>
							<SHORT-NAME>DoorLockIndication_Instance</SHORT-NAME>
							<TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/SWCs/DoorLockIndication_SWC</TYPE-TREF>
						</SW-COMPONENT-PROTOTYPE>
						<SW-COMPONENT-PROTOTYPE>
							<SHORT-NAME>DoorSensorAbstraction_Instance</SHORT-NAME>
							<TYPE-TREF DEST="ECU-ABSTRACTION-SW-COMPONENT-TYPE">/SWCs/DoorSensorAbstraction_SWC</TYPE-TREF>
						</SW-COMPONENT-PROTOTYPE>
					</COMPONENTS>
					<CONNECTORS>
						<ASSEMBLY-SW-CONNECTOR>
							<SHORT-NAME>CON_DoorState</SHORT-NAME>
							<PROVIDER-IREF>
								<CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/Compositions/DoorLockSystem_Comp/DoorSensorAbstraction_Instance</CONTEXT-COMPONENT-REF>
								<TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/SWCs/DoorSensorAbstraction_SWC/P_DoorState</TARGET-P-PORT-REF>
							</PROVIDER-IREF>
							<REQUESTER-IREF>
								<CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/Compositions/DoorLockSystem_Comp/DoorLockIndication_Instance</CONTEXT-COMPONENT-REF>
								<TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/SWCs/DoorLockIndication_SWC/R_DoorState</TARGET-R-PORT-REF>
							</REQUESTER-IREF>
						</ASSEMBLY-SW-CONNECTOR>
						<ASSEMBLY-SW-CONNECTOR>
							<SHORT-NAME>CON_LedControl</SHORT-NAME>
							<PROVIDER-IREF>
								<CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/Compositions/DoorLockSystem_Comp/DoorSensorAbstraction_Instance</CONTEXT-COMPONENT-REF>
								<TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/SWCs/DoorSensorAbstraction_SWC/P_LedControl</TARGET-P-PORT-REF>
							</PROVIDER-IREF>
							<REQUESTER-IREF>
								<CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/Compositions/DoorLockSystem_Comp/DoorLockIndication_Instance</CONTEXT-COMPONENT-REF>
								<TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/SWCs/DoorLockIndication_SWC/R_LedControl</TARGET-R-PORT-REF>
							</REQUESTER-IREF>
						</ASSEMBLY-SW-CONNECTOR>
					</CONNECTORS>
				</COMPOSITION-SW-COMPONENT-TYPE>
			</ELEMENTS>
		</AR-PACKAGE>

	</AR-PACKAGES>
</AUTOSAR>
